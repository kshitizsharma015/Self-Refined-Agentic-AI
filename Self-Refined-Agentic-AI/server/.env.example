# LLM configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
PORT=3000

# Optional Jina Reader key for higher limits on web research requests
JINA_API_KEY=your_jina_api_key_here
JINA_EMBEDDING_MODEL=jina-embeddings-v3

# Optional Reddit user-agent for public API access
REDDIT_USER_AGENT=SynthetixAI/0.1 by student-project

# Optional Piston endpoint override for Hacker Mode code execution
PISTON_API_URL=https://piston.rs/api/v2/execute
PISTON_ALLOW_INSECURE_TLS=true

# Optional Supabase memory backend
# If these are not set, the app automatically uses local file memory.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_TABLE=agent_memory_episodes
